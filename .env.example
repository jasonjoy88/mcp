# Environment variables example for multica-mcp (Python)

# Required
MULTICA_BASE_URL=https://your-multica-instance.example.com
MULTICA_TOKEN=mul_xxxxxxxxxxxxxxxxxxxx

# Workspace (set one or let it auto-detect single workspace)
MULTICA_WORKSPACE_ID=
MULTICA_WORKSPACE_SLUG=

# MCP transport: stdio (default) or http
MCP_TRANSPORT=stdio

# HTTP mode (only relevant when MCP_TRANSPORT=http)
MCP_HTTP_PORT=8080
MCP_API_KEY=

# Logging: debug, info, warn, error
LOG_LEVEL=info

# Read-only mode: disable all write tools
MULTICA_READ_ONLY=false
