# ===== multica-mcp 环境变量配置 =====
# 复制为 .env 后填入真实值。
# 注意：不要把这个文件提交到 git（.env 已在 .gitignore 中）。

# ---- 必填 ----
# Multica 实例地址
MULTICA_BASE_URL=https://multica.leyodev.cn
# Personal Access Token，在 Multica → Settings → Personal Access Tokens 创建，mul_ 开头
MULTICA_TOKEN=mul_xxxxxxxxxxxxxxxxxxxx

# ---- Workspace（三选一，或满足单 workspace 自动探测）----
# 优先用 slug（更可读）；两者都设时 slug 生效
MULTICA_WORKSPACE_SLUG=
MULTICA_WORKSPACE_ID=

# ---- Transport ----
# stdio：本地 IDE 集成（Cursor / Claude Code 等）
# http ：服务端部署，接 WorkBuddy 连接器 / Buddy App  ← 转 Buddy App 用这个
MCP_TRANSPORT=http

# HTTP 模式监听端口
MCP_HTTP_PORT=8080

# HTTP 模式的访问密钥。设置后所有 MCP 请求必须带 Authorization: Bearer <key>
# 服务端部署强烈建议设置；不设置则完全无鉴权
MCP_API_KEY=

# ---- 行为开关 ----
# true 时禁用所有写工具（创建/更新任务、加评论、指派等），只保留只读工具
# 初次接入建议先设 true 验证读链路，确认无误再放开
MULTICA_READ_ONLY=false

# 日志级别：debug / info / warn / error
LOG_LEVEL=info
